# Chave da API do Gemini (Google AI Studio). Fica só no servidor.
GEMINI_API_KEY=
# Modelo do tutor. Padrão: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
# Opcional. Modelo reserva, usado uma vez quando o principal está sobrecarregado
# (503/429) mesmo depois de 2 novas tentativas. Padrão: gemini-3.5-flash-lite
# GEMINI_MODEL_RESERVA=gemini-3.5-flash-lite
