     "solucaoDeTeste": [
      {
       "tipo": "definirSnippet",
       "codigo": "// Plano: Relatório do conserto\n// 1. O que estava errado\n//   1.1 A quantidade da entrega chega como texto e o + junta em vez de somar\n// 2. Como foi achado\n//   2.1 Comparei o dia que fecha certo com o dia da entrega que falhava\n//   2.2 Parei na linha da conta e observei o tipo da quantidade\n// 3. Como foi testado\n//   3.1 Rodei o dia da entrega digitada e o estoque fechou certo\n//   3.2 Rodei de novo os dias antigos, só com venda e com entrega em número\n\nfunction fecharDia(estoque, movimentos) {\n  for (const mov of movimentos) {\n    if (estoque[mov.codigo] !== undefined) {\n      const quantidade = Number(mov.quantidade);\n      if (mov.tipo === \"venda\") {\n        estoque[mov.codigo] = estoque[mov.codigo] - quantidade;\n      } else {\n        estoque[mov.codigo] = estoque[mov.codigo] + quantidade;\n      }\n    }\n  }\n  return estoque;\n}\nconst segunda = fecharDia({ arroz: 10, feijao: 6 }, [{ codigo: \"arroz\", tipo: \"venda\", quantidade: 3 }]);\nconst sexta = fecharDia({ arroz: 10, feijao: 6 }, [{ codigo: \"feijao\", tipo: \"entrega\", quantidade: \"4\" }]);"
      },
